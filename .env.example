# ==============================================================================
# Airlock Environment Configuration Example
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/airlock.db

# Payment Rail Selection
# Options:
#   mock           - (Default) Safe local mock adapter with zero external dependencies.
#   paypal_sandbox - Live PayPal Sandbox REST API integration. Requires valid credentials below.
# Safety guard: Live production endpoints (api.paypal.com) are strictly refused by code.
PAYMENT_PROVIDER=mock

# PayPal Sandbox Credentials (Used only when PAYMENT_PROVIDER=paypal_sandbox)
# Get these from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Note: There is no PAYPAL_SANDBOX_CAPTURE_ID environment variable.
# Users must enter a valid PayPal Sandbox capture ID directly in the
# dashboard UI's "PayPal Capture ID" field. Create test captures via
# PayPal Sandbox orders: https://developer.paypal.com/docs/api/orders/v2/

# Optional self-hosted open-source safety judge (IBM Granite Guardian via Ollama).
# Run `ollama pull granite4.1-guardian:8b`; inference stays on this host/service.
# Leave OLLAMA_BASE_URL blank to use the deterministic local heuristic instead.
OLLAMA_BASE_URL=
AIRLOCK_GUARD_MODEL=granite4.1-guardian:8b

# Optional paid TypeSafe Jev provider. The local Ollama model takes priority when configured.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Airlock Policy Engine Configuration (minor units in USD cents)
# Auto-approval threshold: operations strictly above this amount require human approval
POLICY_APPROVAL_THRESHOLD_MINOR=5000
# Cumulative cap per payment across all refunds (e.g., $200.00)
POLICY_CUMULATIVE_CAP_MINOR=20000
# Velocity limit: maximum refunds per caller in window
POLICY_VELOCITY_MAX_REFUNDS=5
# Velocity window in seconds (e.g., 1 hour = 3600s)
POLICY_VELOCITY_WINDOW_SECONDS=3600

# Fault Injection Wrapper (Sandbox / Mock testing only)
# Options: none | timeout_drop_response | timeout_not_executed | delay
SIMULATE_FAULT=none

