# ==============================================================================
# Airlock Environment Configuration Example
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/airlock.db

# PayPal Sandbox Credentials
# Get these from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# TypeSafe AI / Jev (Advisory model for text safety signals)
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Airlock Policy Engine Configuration (minor units in USD cents)
# Auto-approval threshold: operations strictly above this amount require human approval
POLICY_APPROVAL_THRESHOLD_MINOR=5000
# Cumulative cap per payment across all refunds (e.g., $200.00)
POLICY_CUMULATIVE_CAP_MINOR=20000
# Velocity limit: maximum refunds per caller in window
POLICY_VELOCITY_MAX_REFUNDS=5
# Velocity window in seconds (e.g., 1 hour = 3600s)
POLICY_VELOCITY_WINDOW_SECONDS=3600

# Fault Injection Wrapper (Sandbox / Mock testing only)
# Options: none | timeout_drop_response | timeout_not_executed | delay
SIMULATE_FAULT=none

