{
  "name": "airlock-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "providers/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:packages": "tsc -b",
    "build": "tsc -b && npm run build --workspace=@airlock/dashboard",
    "mcp": "node services/mcp-server/dist/cli.js",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
